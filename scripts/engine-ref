# Pinned container engine, read by scripts/fetch-engine.sh. The sha256 is pinned HERE, not
# fetched next to the file it guards. Only an arm64 pkg exists for this release (Intel Macs
# are unsupported). Keep the version equal to what existing VMs were created with.
VERSION=6.0.2
ARM64_SHA256=5a1d97f98f626cdb82dbd9932cf43102d1e9b6621627085fec2dcadf59743930
# podman 6.0.2's pkg ships gvproxy from gvisor-tap-vsock v0.8.9, affected by CVE-2026-107935 (fixed in
# v0.9.0). The pkg's gvproxy is replaced by this release binary (universal Mach-O, signed by us at build).
GVPROXY_VERSION=v0.9.0
GVPROXY_SHA256=e2a6825ba789fe588828b418c09aaf16525dec6d8cb2d16c94e72535dd4606be
# Windows engine (scripts/fetch-engine.ps1). amd64 only for now. The zip's podman.exe and win-sshproxy.exe
# are bundled; its gvproxy.exe (same v0.8.9 as the mac pkg, CVE-2026-107935) is replaced by the pinned
# release binary below. The zip name and layout are from the v6.0.2 release; the version stays equal to VERSION.
WINDOWS_AMD64_ZIP=podman-remote-release-windows_amd64.zip
